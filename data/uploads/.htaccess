# Mencegah eksekusi script PHP di dalam folder uploads
<FilesMatch "(?i)\.(php|php[0-9]|phtml|phps|exe|pl|py|cgi|sh|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
Options -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
