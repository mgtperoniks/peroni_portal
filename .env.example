# ==============================================================================
# PERONI APPLICATION TERMINAL - ENVIRONMENT CONFIGURATION (PRODUCTION)
# PT Peroni Karya Sentra
# ==============================================================================

# Mode Environment (production / development)
APP_ENV=production

# Port Host untuk Peroni Portal
PORT=9999

# Kata Sandi Administrator Produksi (WAJIB DIISI DENGAN KATA SANDI KUAT)
# Docker Compose akan menolak menjalankan container jika variabel ini tidak disetel.
PERONI_ADMIN_PASSWORD=GantiDenganKataSandiKuatAnda123!

# Opsional: Jika menggunakan bcrypt hash alih-alih plain text password
# PERONI_ADMIN_HASH=
